NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/ticketing
REDIS_URL=redis://localhost:6379
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
# Number of proxies in front of the API (0 locally, usually 1 behind a load balancer)
TRUST_PROXY=0
# Public URL of the frontend
APP_URL=http://localhost:3000
# Name printed on the PDF tickets
BRAND_NAME=Gatepass

# --- Secrets: run `npm run keys` and paste both lines here ---
JWT_SECRET=
# Signs ticket QR codes. Never change it after tickets go out, or every issued ticket stops scanning.
TICKET_SIGNING_KEY=

# WhatsApp number buyers message to pay, with country code, digits only
WHATSAPP_NUMBER=2348012345678
# Hours an unpaid order holds its tickets
ORDER_TTL_HOURS=24

# Admin session cookie. In production over HTTPS with the frontend on another domain, use COOKIE_SAMESITE=none
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true   # defaults to true when NODE_ENV=production

# --- Email ---
# Resend (recommended): paste your API key and set MAIL_FROM to an address on a domain verified in Resend.
RESEND_API_KEY=
# Optional: where buyers' replies go
MAIL_REPLY_TO=
# Or SMTP instead of Resend. With neither set, emails are saved to backend/.mail/ instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Gatepass Tickets <tickets@yourdomain.com>"

# --- Event images ---
# Paste the "API environment variable" from your Cloudinary dashboard to store uploads there.
# Leave empty to save images in backend/uploads (fine locally; lost on redeploy on most free hosts).
CLOUDINARY_URL=
# Optional: folder inside your Cloudinary media library
CLOUDINARY_FOLDER=gatepass/events
